# Installed by setup.sh. This copy is the reference -- keep them in step.
# sudo cp py_new.service /etc/systemd/system/ && sudo systemctl daemon-reload

[Unit]
Description=Scan Gopro Service
After=network.target bluetooth.target

[Service]
Type=simple
WorkingDirectory=/home/pi/Desktop
EnvironmentFile=-/home/pi/Desktop/.env
ExecStart=/usr/bin/python3 /home/pi/Desktop/py_new.py
Restart=always
# 10s, not 60. Nothing is scanning during this gap, so it is dead time added to
# whatever already went wrong: the stale-scan watchdog can take 120s to notice a
# wedged scanner, and a minute of RestartSec on top means ~3 minutes with no
# camera heard. Measured 2026-09-13, killing bluepy-helper by hand: the watchdog
# exited at 14:02:47 and nothing scanned again until the restart. systemd's
# default start limit (5 starts / 10s) is not at risk at this spacing.
RestartSec=10
StandardOutput=journal
StandardError=journal

# KillMode=mixed: SIGTERM goes to the main process only, not to every process
# in the cgroup. The default (control-group) SIGTERMs bluepy-helper directly,
# so it dies before the scanner can tell it to stop scanning -- and a raw HCI
# scan that is never disabled latches the controller, which is what left hci1
# deaf for six days. This gives the scanner's own handler time to win that race.
KillMode=mixed
TimeoutStopSec=15

# And the belt to that pair of braces. This runs after the service has stopped,
# however it stopped -- clean exit, crash, SIGKILL, watchdog, deploy restart --
# when there is nothing left to race. A latched adapter cannot survive it.
#
# Invoked through bash on purpose. systemd requires the exec bit on an
# ExecStopPost program and fails the stop with 203/EXEC without it, so a
# checkout that loses the mode -- Windows, an archive, a stray chmod -- would
# quietly take the only guard against the latch with it.
ExecStopPost=/bin/bash /home/pi/Desktop/bt_scan_reset.sh

[Install]
WantedBy=multi-user.target
